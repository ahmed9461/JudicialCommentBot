# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120

# Database
DATABASE_URL=sqlite+aiosqlite:///runtime/judicial_comment_bot.db

# Search / scoring
AUTO_ACCEPT_SCORE=90
CANDIDATE_DISPLAY_COUNT=3
SEARCH_CANDIDATE_LIMIT=8
SEARCH_RETRY_ROUNDS=2

# Runtime
TEMP_DIR=runtime/tmp
LOG_LEVEL=INFO
DELETE_FILES_AFTER_SEND=true
STALE_TEMP_MAX_AGE_HOURS=6

# PDF / extraction
PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=1500
PDF_DOWNLOAD_TIMEOUT_SECONDS=90
PDF_MAX_REDIRECTS=5
COMPILATION_PAGE_THRESHOLD=60
COMMENTARY_INPUT_MAX_CHARS=70000
COMMENTARY_MIN_TEXT_CHARS=500
