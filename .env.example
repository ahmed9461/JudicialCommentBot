# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# DeepSeek Responses API + server-side web search
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120

# Database
DATABASE_URL=sqlite+aiosqlite:///runtime/judicial_comment_bot.db

# Search / scoring
AUTO_ACCEPT_SCORE=90
CANDIDATE_DISPLAY_COUNT=3
SEARCH_CANDIDATE_LIMIT=8

# Runtime
TEMP_DIR=runtime/tmp
LOG_LEVEL=INFO
DELETE_FILES_AFTER_SEND=true
