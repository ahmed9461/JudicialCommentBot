# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# DeepSeek (required starting from the research/generation phases)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Database
DATABASE_URL=sqlite+aiosqlite:///runtime/judicial_comment_bot.db

# Search / scoring
AUTO_ACCEPT_SCORE=90
CANDIDATE_DISPLAY_COUNT=3
SEARCH_CANDIDATE_LIMIT=8

# Runtime
TEMP_DIR=runtime/tmp
LOG_LEVEL=INFO
DELETE_FILES_AFTER_SEND=true
