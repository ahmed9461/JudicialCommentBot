# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_RESEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_COMMENTARY_MODEL=deepseek-v4-pro

# Native Responses API streaming. These are idle/connect timeouts, not total job deadlines.
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=15
# Search/ranking stream idle deadline.
DEEPSEEK_STREAM_IDLE_TIMEOUT_SECONDS=180
# Final legal drafting can legitimately think longer than search; it has its own idle deadline.
DEEPSEEK_COMMENTARY_IDLE_TIMEOUT_SECONDS=420

# Check balance/model availability before web fallback. Successful preflight is cached for 5 minutes.
DEEPSEEK_PREFLIGHT_TTL_SECONDS=300

# Web research is fallback-only. If needed it is two-stage: one discovery pass, then
# one structured synthesis from the same web_search_call results.
DEEPSEEK_RESEARCH_ATTEMPTS=1
DEEPSEEK_SYNTHESIS_ATTEMPTS=1
DEEPSEEK_MAX_SEARCH_CALLS_FOR_SYNTHESIS=6
DEEPSEEK_RESEARCH_REASONING_EFFORT=none
DEEPSEEK_SYNTHESIS_REASONING_EFFORT=low
DEEPSEEK_COMMENTARY_REASONING_EFFORT=high

# A rejected completed draft may be corrected once against the exact same verified judgment.
# Network/stream timeouts are not automatically retried to avoid duplicate API spend.
COMMENTARY_VALIDATION_ATTEMPTS=2

# Database
DATABASE_URL=sqlite+aiosqlite:///runtime/judicial_comment_bot.db

# Search / scoring
AUTO_ACCEPT_SCORE=90
CANDIDATE_DISPLAY_COUNT=3
SEARCH_CANDIDATE_LIMIT=5
SEARCH_RETRY_ROUNDS=1

# Official judicial catalog: primary discovery path for all courses.
CATALOG_ENABLED=true
CATALOG_FALLBACK_TO_WEB=true
CATALOG_MIN_CANDIDATES_BEFORE_FALLBACK=3
CATALOG_MANIFEST_PATH=config/catalog_sources.yaml

# Runtime
TEMP_DIR=runtime/tmp
LOG_LEVEL=INFO
DELETE_FILES_AFTER_SEND=true
STALE_TEMP_MAX_AGE_HOURS=6
PROGRESS_UPDATE_INTERVAL_SECONDS=3

# PDF / extraction
PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=1500
# Hard wall-clock deadline for downloading + basic validation of one official PDF.
PDF_DOWNLOAD_TIMEOUT_SECONDS=45
PDF_CONNECT_TIMEOUT_SECONDS=10
# Blocking pypdf verification/extraction runs in a worker thread and each stage gets this deadline.
PDF_PROCESSING_TIMEOUT_SECONDS=90
PDF_MAX_REDIRECTS=5
COMPILATION_PAGE_THRESHOLD=60
COMMENTARY_INPUT_MAX_CHARS=70000
COMMENTARY_MIN_TEXT_CHARS=500
